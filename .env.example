# === AI Development Orchestrator V2 ===

# --- Provider Selection ---
AI_PLANNER_PROVIDER=openai
AI_DEVELOPER_PROVIDER=cursor-cli
AI_REVIEWER_PROVIDER=openai

# --- OpenAI Configuration ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-sol

# --- Cursor CLI Configuration ---
CURSOR_COMMAND=agent
CURSOR_MODEL=auto

# --- Legacy Codex Configuration ---
AI_DEVELOPER_MODEL=gpt-5.6-luna
AI_REVIEWER_MODEL=gpt-5.6-sol
AI_CODEX_DEVELOPER_SANDBOX=workspace-write
CODEX_COMMAND=codex
CODEBUDDY_COMMAND=codebuddy

# --- Mock Modes (testing only) ---
MOCK_DEVELOPER_MODE=pass
MOCK_REVIEW_MODE=pass

# --- Timeouts (milliseconds) ---
AI_COMMAND_TIMEOUT_MS=1800000
AI_PLANNER_TIMEOUT_MS=300000
AI_REVIEWER_TIMEOUT_MS=600000
AI_DEVELOPER_TIMEOUT_MS=3600000

# --- Loop Control ---
AI_MAX_REVIEW_ROUNDS=3
AI_MAX_TASKS_PER_RUN=10
AI_MAX_RUNTIME_MINUTES=480

# --- Auto Actions ---
AI_AUTO_COMMIT=false
AI_AUTO_PUSH=false
AI_AUTO_NEXT_TASK=true

# --- Stop Policy ---
AI_STOP_ON_MEDIUM=false
AI_STOP_ON_HIGH=true
AI_STOP_ON_BLOCKER=true

# --- Budget ---
AI_MAX_OPENAI_CALLS=50
AI_MAX_CURSOR_CALLS=50

# --- Branch ---
AI_BRANCH=ai-automation-bootstrap

# --- Workspace ---
AI_WORKSPACE=.

# --- Review Context ---
AI_REVIEW_CONTEXT_LINES=200

# --- Worktree ---
AI_USE_WORKTREE=false

# --- Git TLS (Windows) ---
AI_GIT_SCHANNEL_RETRY=true