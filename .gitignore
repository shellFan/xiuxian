node_modules/
.env
*.log
ai/logs/*
!ai/logs/.gitkeep
ai/state/*
!ai/state/.gitkeep
ai/reports/*
!ai/reports/.gitkeep
ai/reviews/*
!ai/reviews/.gitkeep
*.tsbuildinfo
tests/.compiled/
/tmp/

# WorkBuddy local memory / workspace state (never commit)
.workbuddy/

# Cocos Creator generated runtime/cache (not project source)
/library/
/temp/
/local/
/profiles/
.creator/
/build/
/dist/
/_task5-build/
/_task5-build2/
/desktop/build/

# Cocos .meta files MUST be tracked (required for scene/prefab references)
!assets/**/*.metatmp/
