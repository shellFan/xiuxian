{
  "id": "gameplay-cycle",
  "title": "Tasks, work wages, coffee, day refresh, settlement, three workdays and save recovery",
  "setup": "new-player",
  "continueOnFailure": true,
  "steps": [
    { "action": "call", "method": "snapshot", "as": "beforeTask" },
    { "action": "call", "method": "queryAssignedTasks", "as": "assigned" },
    { "action": "assert", "check": "gte", "path": "@vars.assigned.openCount", "expected": 1, "description": "The task list contains an open assigned task" },
    { "action": "call", "method": "completeAssignedTask", "args": ["@vars.assigned.all[0].id"], "as": "taskCompletion", "description": "Complete and claim the onboarding work task" },
    { "action": "call", "method": "snapshot", "as": "afterTask" },
    { "action": "assert", "check": "gt", "path": "@vars.afterTask.salary", "expected": "@vars.beforeTask.salary", "description": "Completing the task credits the canonical salary wallet" },
    { "action": "call", "method": "queryHomeGoals", "as": "goalsAfterTask" },
    { "action": "assert", "check": "gte", "path": "@vars.goalsAfterTask[0].progress", "expected": 1, "description": "Task completion advances a daily home goal" },
    { "action": "call", "method": "changeWorkMode", "args": ["WORK"], "as": "working" },
    { "action": "call", "method": "snapshot", "as": "beforeWork" },
    { "action": "call", "method": "tick", "args": [3600], "description": "Advance one real test hour through the authoritative game loop" },
    { "action": "call", "method": "snapshot", "as": "afterWork" },
    { "action": "assert", "check": "gt", "path": "@vars.afterWork.salary", "expected": "@vars.beforeWork.salary", "description": "Work advances the canonical wage balance" },
    { "action": "assert", "check": "gt", "path": "@vars.afterWork.workSeconds", "expected": "@vars.beforeWork.workSeconds", "description": "Game time advances the real work-time counter" },
    { "action": "call", "method": "queryHomeLifeOptions", "as": "lifeBefore" },
    { "action": "call", "method": "consumeHomeLife", "args": ["COFFEE"], "as": "coffee", "description": "Buy coffee through the existing wallet and life service" },
    { "action": "assert", "check": "truthy", "path": "@vars.coffee.ok", "description": "Coffee purchase succeeds with earned task and work salary" },
    { "action": "assert", "check": "equals", "path": "@vars.coffee.cost", "expected": 18, "description": "A coffee costs exactly ¥18" },
    { "action": "call", "method": "snapshot", "as": "afterCoffee" },
    { "action": "assert", "check": "change", "path": "@vars.afterCoffee.salary", "from": "@vars.afterWork.salary", "expected": -18, "description": "Coffee subtracts ¥18 from the canonical wallet" },
    { "action": "call", "method": "queryBattle", "as": "battle" },
    { "action": "assert", "check": "exists", "path": "@vars.battle", "description": "The battle service exposes its authoritative runtime state" },
    { "action": "call", "method": "queryGameClock", "as": "clockBeforeRollover" },
    { "action": "call", "method": "devJumpToHour", "args": [8, 0], "description": "Use the existing development clock service to reach the next day" },
    { "action": "call", "method": "queryGameClock", "as": "clockAfterRollover" },
    { "action": "assert", "check": "gt", "path": "@vars.clockAfterRollover.dayNumber", "expected": "@vars.clockBeforeRollover.dayNumber", "description": "Crossing to the next day refreshes the game date" },
    { "action": "call", "method": "queryCanSettleDay", "as": "settlementAvailable" },
    { "action": "call", "method": "queryGameDay", "as": "workdayBefore" },
    { "action": "call", "method": "devJumpToHour", "args": [18, 0], "description": "Advance to the daily settlement boundary" },
    { "action": "call", "method": "tick", "args": [60], "description": "Process the existing daily settlement loop" },
    { "action": "call", "method": "queryGameDay", "as": "workdayAfter" },
    { "action": "assert", "check": "gte", "path": "@vars.workdayAfter.dayIndex", "expected": 1, "description": "The daily workday is represented in the game-day service" },
    { "action": "call", "method": "devJumpToHour", "args": [9, 0] },
    { "action": "call", "method": "tick", "args": [3600], "description": "Play through another workday with real work and clock services" },
    { "action": "call", "method": "devJumpToHour", "args": [9, 0] },
    { "action": "call", "method": "tick", "args": [3600] },
    { "action": "call", "method": "devJumpToHour", "args": [9, 0] },
    { "action": "call", "method": "tick", "args": [3600] },
    { "action": "call", "method": "devJumpToHour", "args": [9, 0] },
    { "action": "call", "method": "tick", "args": [3600] },
    { "action": "call", "method": "queryGameDay", "as": "threeWorkdayState" },
    { "action": "assert", "check": "gte", "path": "@vars.threeWorkdayState.dayIndex", "expected": 3, "description": "Three consecutive game workdays reach the existing settlement service" },
    { "action": "call", "method": "snapshot", "as": "beforeRestart" },
    { "action": "call", "method": "save", "description": "Persist the game through its existing save service" },
    { "action": "restart", "description": "Close and reopen the real EXE with the same isolated test profile" },
    { "action": "call", "method": "snapshot", "as": "afterRestart" },
    { "action": "assert", "check": "equals", "path": "@vars.afterRestart.salary", "expected": "@vars.beforeRestart.salary", "description": "The game resumes with its last saved salary" },
    { "action": "call", "method": "queryHomeSnapshot", "as": "homeAfterRestart" },
    { "action": "assert", "check": "exists", "path": "@vars.homeAfterRestart.work.professionId", "description": "The saved profession and main loop recover after relaunch" },
    { "action": "screenshot", "name": "three-workdays-after-restart", "description": "Keep a real window screenshot of the recovered workday" }
  ]
}
