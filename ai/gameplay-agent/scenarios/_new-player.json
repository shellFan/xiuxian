{
  "id": "new-player-setup",
  "title": "Walk the eight-step character creator and choose a sect using real EXE input",
  "steps": [
    {"action":"call","method":"queryCharacterCreation","as":"creation","description":"Read authoritative initial character creation state"},
    {"action":"assert","check":"equals","path":"@vars.creation.status","expected":"CREATION_REQUIRED","description":"A new isolated test profile starts at character creation"},
    {"action":"screenshot","name":"creation-industry","description":"Capture the first creation step"},
    {"action":"clickUntilState","selector":"[data-creation-choice=\"industry:INTERNET\"]","method":"queryCharacterCreation","path":"draft.industry","from":null,"expected":"INTERNET","maxAttempts":3,"timeoutMs":1000,"description":"Choose internet industry and confirm the authoritative draft before advancing"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"advance\"]","method":"queryCharacterCreation","path":"draft.step","from":"INDUSTRY","expected":"DIRECTION","maxAttempts":3,"timeoutMs":1000,"description":"Click the visible next-step button and wait for the authoritative direction state"},
    {"action":"call","method":"queryCharacterCreation","as":"directionStep","description":"Confirm the second creation step"},
    {"action":"assert","check":"equals","path":"@vars.directionStep.draft.step","expected":"DIRECTION"},
    {"action":"screenshot","name":"creation-direction"},
    {"action":"clickUntilState","selector":"[data-creation-choice=\"direction:TECH_RND\"]","method":"queryCharacterCreation","path":"draft.direction","from":null,"expected":"TECH_RND","maxAttempts":3,"timeoutMs":1000,"description":"Select the available technical direction and wait for the authoritative draft to record it"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"advance\"]","method":"queryCharacterCreation","path":"draft.step","from":"DIRECTION","expected":"PROFESSION","maxAttempts":3,"timeoutMs":1000,"description":"Advance to profession and verify the authoritative wizard state"},
    {"action":"call","method":"queryCharacterCreation","as":"professionStep"},
    {"action":"assert","check":"equals","path":"@vars.professionStep.draft.step","expected":"PROFESSION"},
    {"action":"screenshot","name":"creation-profession"},
    {"action":"click","selector":"[data-creation-choice=\"profession:JAVA_BACKEND\"]","description":"Choose Java backend profession"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"advance\"]","method":"queryCharacterCreation","path":"draft.step","from":"PROFESSION","expected":"SECT","maxAttempts":3,"timeoutMs":1000,"description":"Advance to sect selection and verify the authoritative wizard state"},
    {"action":"call","method":"queryCharacterCreation","as":"sectStep","description":"Read the authoritative sect selection step"},
    {"action":"assert","check":"equals","path":"@vars.sectStep.draft.step","expected":"SECT","description":"The wizard requires an explicit sect choice"},
    {"action":"screenshot","name":"creation-sect","description":"Capture sect choices before selection"},
    {"action":"clickUntilState","selector":"[data-creation-choice=\"sect:OUTSOURCING\"]","method":"queryCharacterCreation","path":"draft.sectId","from":null,"expected":"OUTSOURCING","maxAttempts":3,"timeoutMs":1000,"as":"selectedSect","asType":"object","description":"Choose the outsourcing sect and wait for the authoritative draft field"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"advance\"]","method":"queryCharacterCreation","path":"draft.step","from":"SECT","expected":"IDENTITY","maxAttempts":3,"timeoutMs":1000,"description":"Advance from sect choice to identity and verify the authoritative state"},
    {"action":"call","method":"queryCharacterCreation","as":"identityStep"},
    {"action":"assert","check":"equals","path":"@vars.identityStep.draft.step","expected":"IDENTITY"},
    {"action":"screenshot","name":"creation-identity"},
    {"action":"type","selector":"#v59-nickname","text":"试玩修士","description":"Enter a test nickname with real keyboard input"},
    {"action":"scroll","selector":".v59-step-content","deltaY":150,"ensureVisibleSelector":"[data-creation-action=\"save-identity\"]","keyboardRecoveryMaxTabSteps":24,"description":"Scroll the identity form until its save control is inside the clipped panel"},
    {"action":"assertClickable","selector":"[data-creation-action=\"save-identity\"]","description":"Verify the identity save control is now visible and uncovered"},
    {"action":"click","selector":"[data-creation-action=\"save-identity\"]","description":"Save identity through the creation UI"},
    {"action":"wait","ms":250,"description":"Wait for the identity form save to settle before changing the scroll region"},
    {"action":"scroll","selector":".v59-step-content","deltaY":350,"ensureVisibleSelector":"[data-creation-choice=\"background:ORDINARY_WORKER\"]","keyboardRecoveryMaxTabSteps":24,"description":"Scroll to the background choices after saving identity"},
    {"action":"clickUntilState","selector":"[data-creation-choice=\"background:ORDINARY_WORKER\"]","method":"queryCharacterCreation","path":"draft.background","from":null,"expected":"ORDINARY_WORKER","maxAttempts":3,"timeoutMs":1000,"as":"savedIdentity","asType":"object","description":"Choose a valid starting background and wait for the authoritative draft field"},
    {"action":"screenshot","name":"creation-identity-backgrounds","description":"Verify the background choice through its selected UI state"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"advance\"]","method":"queryCharacterCreation","path":"draft.step","from":"IDENTITY","expected":"DESTINY","maxAttempts":3,"timeoutMs":1000,"description":"Advance to destiny and verify the authoritative wizard state"},
    {"action":"call","method":"queryCharacterCreation","as":"destinyStep"},
    {"action":"assert","check":"equals","path":"@vars.destinyStep.draft.step","expected":"DESTINY"},
    {"action":"screenshot","name":"creation-destiny"},
    {"action":"scroll","selector":".v59-step-content","deltaY":120,"ensureVisibleSelector":"[data-creation-choice=\"candidate:A\"]","keyboardRecoveryMaxTabSteps":24,"description":"Scroll the tall destiny candidate cards into the visible area"},
    {"action":"clickUntilState","selector":"[data-creation-choice=\"candidate:A\"]","method":"queryCharacterCreation","path":"draft.selectedCandidateId","from":null,"expected":"A","maxAttempts":3,"timeoutMs":1000,"description":"Choose a destiny candidate and verify the authoritative draft records it before advancing"},
    {"action":"wait","ms":300,"description":"Allow the selected destiny to settle before advancing"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"advance\"]","method":"queryCharacterCreation","path":"draft.step","from":"DESTINY","expected":"ALLOCATION","maxAttempts":3,"timeoutMs":1000,"description":"Advance to allocation and verify the authoritative wizard state"},
    {"action":"call","method":"queryCharacterCreation","as":"allocationStep"},
    {"action":"assert","check":"equals","path":"@vars.allocationStep.draft.step","expected":"ALLOCATION"},
    {"action":"screenshot","name":"creation-allocation"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"allocate\"][data-stat=\"insight\"][data-delta=\"5\"]","method":"queryCharacterCreation","path":"draft.allocation.insight","from":0,"expected":5,"maxAttempts":3,"timeoutMs":500,"description":"Allocate five available points using the visible plus-five control and wait for the authoritative draft to update"},
    {"action":"call","method":"queryCharacterCreation","as":"afterPlusFive","asType":"object"},
    {"action":"assert","check":"equals","path":"@vars.afterPlusFive.draft.allocation.insight","expected":5,"description":"The authoritative creation draft records the five-point allocation"},
    {"action":"screenshot","name":"creation-allocation-plus-five"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"allocate\"][data-stat=\"insight\"][data-delta=\"-1\"]","method":"queryCharacterCreation","path":"draft.allocation.insight","from":5,"expected":4,"maxAttempts":3,"timeoutMs":500,"description":"Return the first point using the visible minus-one control"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"allocate\"][data-stat=\"insight\"][data-delta=\"-1\"]","method":"queryCharacterCreation","path":"draft.allocation.insight","from":4,"expected":3,"maxAttempts":3,"timeoutMs":500},
    {"action":"clickUntilState","selector":"[data-creation-action=\"allocate\"][data-stat=\"insight\"][data-delta=\"-1\"]","method":"queryCharacterCreation","path":"draft.allocation.insight","from":3,"expected":2,"maxAttempts":3,"timeoutMs":500},
    {"action":"clickUntilState","selector":"[data-creation-action=\"allocate\"][data-stat=\"insight\"][data-delta=\"-1\"]","method":"queryCharacterCreation","path":"draft.allocation.insight","from":2,"expected":1,"maxAttempts":3,"timeoutMs":500},
    {"action":"clickUntilState","selector":"[data-creation-action=\"allocate\"][data-stat=\"insight\"][data-delta=\"-1\"]","method":"queryCharacterCreation","path":"draft.allocation.insight","from":1,"expected":0,"maxAttempts":3,"timeoutMs":500,"description":"Return the remaining points through five rapid UI interactions without changing the randomized base value"},
    {"action":"call","method":"queryCharacterCreation","as":"afterMinusFive","asType":"object"},
    {"action":"assert","check":"equals","path":"@vars.afterMinusFive.draft.allocation.insight","expected":0,"description":"Five minus-one clicks restore the original allocation"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"advance\"]","method":"queryCharacterCreation","path":"draft.step","from":"ALLOCATION","expected":"CONFIRM","maxAttempts":3,"timeoutMs":1000,"description":"Keep the valid default allocation and verify the confirmation state"},
    {"action":"call","method":"queryCharacterCreation","as":"confirmStep"},
    {"action":"assert","check":"equals","path":"@vars.confirmStep.draft.step","expected":"CONFIRM"},
    {"action":"screenshot","name":"creation-confirm"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"finalize\"]","method":"queryCharacterCreation","path":"status","from":"CREATION_REQUIRED","expected":"COMPLETE","maxAttempts":3,"timeoutMs":1500,"as":"completeCreation","asType":"object","description":"Finalize through the UI and wait for the authoritative save receipt before dependent scenarios continue"},
    {"action":"call","method":"queryCharacterCreation","as":"completeCreation"},
    {"action":"assert","check":"equals","path":"@vars.completeCreation.status","expected":"COMPLETE"},
    {"action":"screenshot","name":"creation-onboarding"},
    {"action":"clickUntilState","selector":"[data-creation-action=\"onboarding-skip\"]","method":"queryCharacterOnboarding","path":"step","from":"INTRO_1","expected":"COMPLETE","as":"onboardingAfterSkip","maxAttempts":3,"timeoutMs":1000,"description":"Enter the game through the real onboarding control and verify its authoritative state, retrying only while still at the first story step"},
    {"action":"assert","check":"equals","path":"@vars.onboardingAfterSkip.step","expected":"COMPLETE","description":"The onboarding action completed before dependent first-task checks"},
    {"action":"call","method":"queryAssignedTasks","as":"firstTask"},
    {"action":"assert","check":"gte","path":"@vars.firstTask.openCount","expected":1,"description":"Onboarding creates its first real assigned task"},
    {"action":"screenshot","name":"home"}
  ]
}
