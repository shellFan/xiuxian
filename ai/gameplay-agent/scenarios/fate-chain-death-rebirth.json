{
  "id": "fate-chain-death-rebirth",
  "title": "Intern chain reaches a death ending, settles karma, purchases a talent, and resumes after rebirth",
  "setup": "new-player",
  "setupFailureClass": "SETUP_BLOCKED",
  "steps": [
    { "action": "setViewport", "width": 1280, "height": 720 },
    { "action": "clickUntilState", "selector": "#ArenaAttack", "method": "queryHomeArena", "path": "kills", "from": 0, "expected": 1, "maxAttempts": 3, "timeoutMs": 1000, "description": "Defeat the first enemy through the visible attack button" },
    { "action": "clickUntilState", "selector": "#ArenaAttack", "method": "queryHomeArena", "path": "kills", "from": 1, "expected": 2, "maxAttempts": 3, "timeoutMs": 1000, "description": "Defeat the second enemy and trigger the intern storyline" },
    { "action": "waitFor", "selector": "#FateEventCard[data-event-id=intern_s1]:not([hidden])", "timeoutMs": 5000, "description": "Wait for the first intern story card" },
    { "action": "screenshot", "name": "intern-stage-1", "description": "Capture the actual first story card before choosing" },
    { "action": "assertClickable", "selector": "#FateEventChoices [data-fate-choice=HELP]" },
    { "action": "click", "selector": "#FateEventChoices [data-fate-choice=HELP]", "description": "Help the intern through the rendered event choice" },
    { "action": "waitFor", "selector": "#FateEventCard[data-event-id=intern_s2]:not([hidden])", "timeoutMs": 5000, "description": "Verify the first choice unlocks story stage two" },
    { "action": "click", "selector": "#FateEventChoices [data-fate-choice=HELP]", "description": "Continue the intern chain through its visible choice" },
    { "action": "waitFor", "selector": "#FateEventCard[data-event-id=intern_s3]:not([hidden])", "timeoutMs": 5000 },
    { "action": "click", "selector": "#FateEventChoices [data-fate-choice=HELP]", "description": "Continue the intern chain through its visible choice" },
    { "action": "waitFor", "selector": "#FateEventCard[data-event-id=coffee_event]:not([hidden])", "timeoutMs": 5000, "description": "Resolve the already-queued coffee milestone before the next intern story card" },
    { "action": "assertClickable", "selector": "#FateEventChoices [data-fate-choice=\"NEGOTIATE\"]" },
    { "action": "click", "selector": "#FateEventChoices [data-fate-choice=\"NEGOTIATE\"]", "description": "Resolve the intervening coffee event through its real choice" },
    { "action": "waitFor", "selector": "#FateEventCard[data-event-id=intern_s4]:not([hidden])", "timeoutMs": 5000 },
    { "action": "click", "selector": "#FateEventChoices [data-fate-choice=HELP]", "description": "Continue the intern chain through its visible choice" },
    { "action": "waitFor", "selector": "#FateEventCard[data-event-id=intern_s5]:not([hidden])", "timeoutMs": 5000, "description": "Verify all four prior choices advanced to the fifth story stage" },
    { "action": "screenshot", "name": "intern-stage-5", "description": "Capture the final high-risk story choice before resolving it" },
    { "action": "assertClickable", "selector": "#FateEventChoices [data-fate-choice=RISK]" },
    { "action": "click", "selector": "#FateEventChoices [data-fate-choice=\"RISK\"]", "description": "Take the explicit final risk choice; this authored outcome ends the run" },
    { "action": "call", "method": "queryFateRun", "as": "afterDeath", "asType": "object" },
    { "action": "assert", "check": "equals", "path": "@vars.afterDeath.status", "expected": "ENDED", "description": "The real event outcome ends the fate run" },
    { "action": "assert", "check": "truthy", "path": "@vars.afterDeath.terminalOutcomeId", "description": "The run records whichever fixed-seed risk outcome ended it" },
    { "action": "assert", "check": "equals", "path": "@vars.afterDeath.health", "expected": 0, "description": "The final risk option ends the run regardless of its success or failure branch" },
    { "action": "assert", "check": "equals", "path": "@vars.afterDeath.eventHistory[5].choiceId", "expected": "RISK" },
    { "action": "screenshot", "name": "death-ending", "description": "Capture the real run-end panel and ending" },
    { "action": "assertClickable", "selector": "#FateChallengeControls [data-fate-settle]" },
    { "action": "click", "selector": "#FateChallengeControls [data-fate-settle]", "description": "Settle rebirth karma through the visible run-end control" },
    { "action": "call", "method": "queryFateMeta", "as": "afterSettlement", "asType": "object" },
    { "action": "assert", "check": "gt", "path": "@vars.afterSettlement.karma", "expected": 0, "description": "Settlement grants account-level karma" },
    { "action": "assert", "check": "equals", "path": "@vars.afterSettlement.settledRunIds[0]", "expected": "@vars.afterDeath.runId", "description": "The ended run is recorded as settled exactly once" },
    { "action": "assertClickable", "selector": "#FateTalentList [data-fate-talent=born_cow]" },
    { "action": "click", "selector": "#FateTalentList [data-fate-talent=\"born_cow\"]", "description": "Buy the affordable permanent attack talent through its visible control" },
    { "action": "call", "method": "queryFateMeta", "as": "afterTalent", "asType": "object" },
    { "action": "assert", "check": "equals", "path": "@vars.afterTalent.talentRanks.born_cow", "expected": 1 },
    { "action": "screenshot", "name": "talent-purchased", "description": "Capture the purchased talent and updated karma" },
    { "action": "assertClickable", "selector": "#FateChallengeControls [data-fate-rebirth]" },
    { "action": "click", "selector": "#FateChallengeControls [data-fate-rebirth]", "description": "Start the next life through the visible rebirth control" },
    { "action": "call", "method": "queryFateRun", "as": "afterRebirth", "asType": "object" },
    { "action": "assert", "check": "equals", "path": "@vars.afterRebirth.status", "expected": "ACTIVE" },
    { "action": "assert", "check": "equals", "path": "@vars.afterRebirth.eventHistory.length", "expected": 0 },
    { "action": "restartGame", "description": "Restart the packaged EXE and recover the reborn run" },
    { "action": "call", "method": "queryFateRun", "as": "afterRestart", "asType": "object" },
    { "action": "call", "method": "queryFateMeta", "as": "metaAfterRestart", "asType": "object" },
    { "action": "assert", "check": "equals", "path": "@vars.afterRestart.status", "expected": "ACTIVE" },
    { "action": "assert", "check": "equals", "path": "@vars.metaAfterRestart.talentRanks.born_cow", "expected": 1 },
    { "action": "assert", "check": "equals", "path": "@vars.metaAfterRestart.settledRunIds[0]", "expected": "@vars.afterDeath.runId" },
    { "action": "screenshot", "name": "rebirth-after-restart", "description": "Capture the restored next life after the actual EXE restart" }
  ]
}
