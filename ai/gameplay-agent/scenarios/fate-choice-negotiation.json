{
  "id": "fate-choice-negotiation",
  "title": "Negotiation choice changes the canonical wage and records a different story branch",
  "setup": "new-player",
  "setupFailureClass": "SETUP_BLOCKED",
  "steps": [
    { "action": "setViewport", "width": 1280, "height": 720 },
    { "action": "call", "method": "queryHomeSnapshot", "as": "before", "asType": "object", "description": "Read the existing authoritative home projection before the choice" },
    { "action": "click", "selector": "#ArenaAttack", "description": "Enter normal combat from the home card-battle entry" },
    { "action": "waitFor", "selector": ".ux-cardbattle[data-card-phase=\"PLAYER_ACTION\"]", "timeoutMs": 5000 },
    { "action": "clickIfPresent", "selector": ".ux-weekly-popup .ux-week-close", "timeoutMs": 3000 },
    { "action": "clickIfPresent", "selector": ".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME']", "timeoutMs": 3000 },
    { "action": "clickIfPresent", "selector": "#V2EventOk", "timeoutMs": 3000 },
    { "action": "clickIfPresent", "selector": ".ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE']", "timeoutMs": 3000 },
{"action":"clickUntilState","selector":".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])","method":"queryCardBattle","popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option","path":"hitLog.length","from":0,"expected":1,"maxAttempts":3,"timeoutMs":1500,"routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000},
{"action":"clickUntilState","selector":".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])","method":"queryCardBattle","popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option","path":"hitLog.length","from":1,"expected":2,"maxAttempts":3,"timeoutMs":1500,"routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000},
{"action":"clickUntilState","selector":"[data-action=\"cardEndTurn\"]","method":"queryCardBattle","path":"turn","from":1,"expected":2,"maxAttempts":3,"timeoutMs":1500,"routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000,"popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option"},
{"action":"clickUntilState","selector":".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])","method":"queryCardBattle","path":"hitLog.length","from":2,"expected":3,"maxAttempts":3,"timeoutMs":1500,"routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000,"popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option"},
{"action":"clickUntilState","selector":".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])","method":"queryCardBattle","path":"hitLog.length","from":3,"expected":4,"maxAttempts":3,"timeoutMs":1500,"routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000,"popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option"},
{"action":"clickUntilState","selector":".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])","method":"queryCardBattle","path":"hitLog.length","from":4,"expected":5,"maxAttempts":3,"timeoutMs":1500,"routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000,"popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option"},
{"action":"clickUntilState","selector":"[data-action=\"cardEndTurn\"]","method":"queryCardBattle","path":"turn","from":2,"expected":3,"maxAttempts":3,"timeoutMs":1500,"routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000,"popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option"},
{"action":"clickUntilState","selector":".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])","method":"queryCardBattle","popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option","path":"phase","from":"PLAYER_ACTION","expected":"VICTORY","maxAttempts":3,"timeoutMs":1500,"routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000},
    { "action": "waitFor", "selector": ".ux-cardbattle[data-card-phase=\"VICTORY\"]", "timeoutMs": 5000 },
{"action":"clickUntilState","selector":"[data-action=\"cardReward\"]","method":"queryCardBattle","path":"rewards[0].chosen","from":false,"expected":true,"maxAttempts":3,"timeoutMs":1000,"description":"Choose a visible card-battle reward and verify it in authoritative state","routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000,"popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option"},
{"action":"clickUntilState","selector":"[data-action=\"cardClaim\"]","method":"queryCardBattle","path":"settlement.claimed","from":false,"expected":true,"maxAttempts":3,"timeoutMs":1000,"description":"Claim the selected reward through the visible settlement button","routeRecoverySelector":".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]","routeRecoveryTargetSelector":".ux-cardbattle","routeRecoveryResumeSelector":"#ArenaAttack","routeRecoveryTimeoutMs":3000,"popupChoiceSelector":".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option"},
    { "action": "call", "method": "queryFateRun", "as": "queuedFate", "asType": "object", "description": "Read the persistent Fate queue after the card-battle victory" },
    { "action": "assert", "check": "equals", "path": "@vars.queuedFate.eventQueue[0]", "expected": "intern_s1" },
    { "action": "click", "selector": "[data-nav=\"HOME\"]", "description": "Return home to the page that renders Fate event cards" },
    { "action": "waitFor", "selector": "#FateEventCard[data-event-id=intern_s1]:not([hidden])", "timeoutMs": 5000 },
    { "action": "screenshot", "name": "negotiation-event", "description": "Capture the event choices before committing" },
    { "action": "assertClickable", "selector": "#FateEventChoices [data-fate-choice=\"NEGOTIATE\"]" },
    { "action": "click", "selector": "#FateEventChoices [data-fate-choice=\"NEGOTIATE\"]", "description": "Negotiate using the rendered choice control" },
    { "action": "call", "method": "queryHomeSnapshot", "as": "after", "asType": "object", "description": "Read the canonical wage projection after resolving the choice" },
    { "action": "call", "method": "queryFateRun", "as": "run", "asType": "object" },
    { "action": "assert", "check": "gt", "path": "@vars.after.work.salaryBalance", "expected": "@vars.before.work.salaryBalance", "description": "The successful negotiation credits the existing salary wallet" },
    { "action": "assert", "check": "equals", "path": "@vars.run.eventHistory[0].choiceId", "expected": "NEGOTIATE", "description": "The authoritative history records the selected branch" },
    { "action": "assert", "check": "equals", "path": "@vars.run.flags.intern_s1_negotiate", "expected": true },
    { "action": "screenshot", "name": "negotiation-result", "description": "Capture the wage-changing negotiation outcome" }
  ]
}
