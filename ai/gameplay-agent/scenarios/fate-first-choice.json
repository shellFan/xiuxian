{
  "id": "fate-first-choice",
  "title": "First fate event choice and restart recovery",
  "setup": "new-player",
  "setupFailureClass": "SETUP_BLOCKED",
  "steps": [
    { "action": "setViewport", "width": 1280, "height": 720 },
    { "action": "click", "selector": "#ArenaAttack", "description": "Enter normal combat from the home card-battle entry" },
    { "action": "waitFor", "selector": ".ux-cardbattle[data-card-phase=\"PLAYER_ACTION\"]", "timeoutMs": 5000 },
    { "action": "clickIfPresent", "selector": ".ux-weekly-popup .ux-week-close", "timeoutMs": 3000, "description": "Close a visible weekly recap through its real button" },
    { "action": "clickIfPresent", "selector": ".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME']", "timeoutMs": 3000 },
    { "action": "clickIfPresent", "selector": "#V2EventOk", "timeoutMs": 3000 },
    { "action": "clickIfPresent", "selector": ".ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE']", "timeoutMs": 3000 },
    { "action": "clickUntilState", "selector": ".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])", "method": "queryCardBattle", "popupChoiceSelector": ".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"]", "path": "hitLog.length", "from": 0, "expected": 1, "maxAttempts": 3, "timeoutMs": 1500 },
    { "action": "clickUntilState", "selector": ".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])", "method": "queryCardBattle", "popupChoiceSelector": ".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"]", "path": "hitLog.length", "from": 1, "expected": 2, "maxAttempts": 3, "timeoutMs": 1500 },
    { "action": "clickUntilState", "selector": "[data-action=\"cardEndTurn\"]", "method": "queryCardBattle", "path": "turn", "from": 1, "expected": 2, "maxAttempts": 3, "timeoutMs": 1500 },
    { "action": "clickUntilState", "selector": ".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])", "method": "queryCardBattle", "path": "hitLog.length", "from": 2, "expected": 3, "maxAttempts": 3, "timeoutMs": 1500 },
    { "action": "clickUntilState", "selector": ".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])", "method": "queryCardBattle", "path": "hitLog.length", "from": 3, "expected": 4, "maxAttempts": 3, "timeoutMs": 1500 },
    { "action": "clickUntilState", "selector": ".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])", "method": "queryCardBattle", "path": "hitLog.length", "from": 4, "expected": 5, "maxAttempts": 3, "timeoutMs": 1500 },
    { "action": "clickUntilState", "selector": "[data-action=\"cardEndTurn\"]", "method": "queryCardBattle", "path": "turn", "from": 2, "expected": 3, "maxAttempts": 3, "timeoutMs": 1500 },
    { "action": "clickUntilState", "selector": ".ux-cardbattle-card.ux-cardbattle-attack:not([disabled])", "method": "queryCardBattle", "popupChoiceSelector": ".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-weekly-popup .ux-week-close, .ux-modal-layer #V2EventOk, .ux-modal-layer [data-vevent-choice=\"__auto\"]", "path": "phase", "from": "PLAYER_ACTION", "expected": "VICTORY", "maxAttempts": 3, "timeoutMs": 1500 },
    { "action": "waitFor", "selector": ".ux-cardbattle[data-card-phase=\"VICTORY\"]", "timeoutMs": 5000 },
    { "action": "clickUntilState", "selector": "[data-action=\"cardReward\"]", "method": "queryCardBattle", "path": "rewards[0].chosen", "from": false, "expected": true, "maxAttempts": 3, "timeoutMs": 1000, "description": "Choose a visible card-battle reward and verify it in authoritative state" },
    { "action": "clickUntilState", "selector": "[data-action=\"cardClaim\"]", "method": "queryCardBattle", "path": "settlement.claimed", "from": false, "expected": true, "maxAttempts": 3, "timeoutMs": 1000, "description": "Claim the selected reward through the visible settlement button" },
    { "action": "call", "method": "queryFateRun", "as": "queuedFate", "asType": "object", "description": "Read the persistent Fate queue after the card-battle victory" },
    { "action": "assert", "check": "equals", "path": "@vars.queuedFate.eventQueue[0]", "expected": "intern_s1", "description": "Verify the first story event was queued in authoritative state" },
    { "action": "click", "selector": "[data-nav=\"HOME\"]", "description": "Return to the normal home screen where the Fate event card is rendered" },
    { "action": "waitFor", "selector": "#FateEventCard[data-event-id=intern_s1]:not([hidden])", "timeoutMs": 5000, "description": "Wait for the first story event queued by normal card-battle victory" },
    { "action": "screenshot", "name": "first-event", "description": "Capture the first event before making a choice" },
    { "action": "assertClickable", "selector": "#FateEventChoices [data-fate-choice=HELP]" },
    { "action": "click", "selector": "#FateEventChoices [data-fate-choice=HELP]", "description": "Choose the visible help option through CDP pointer input" },
    { "action": "call", "method": "queryFateRun", "as": "afterChoice", "asType": "object" },
    { "action": "assert", "check": "equals", "path": "@vars.afterChoice.flags.intern_s1_help", "expected": true },
    { "action": "assert", "check": "equals", "path": "@vars.afterChoice.eventHistory[0].choiceId", "expected": "HELP" },
    { "action": "restartGame", "description": "Restart the packaged game to verify the choice persisted" },
    { "action": "call", "method": "queryFateRun", "as": "afterRestart", "asType": "object" },
    { "action": "assert", "check": "equals", "path": "@vars.afterRestart.flags.intern_s1_help", "expected": true },
    { "action": "assert", "check": "equals", "path": "@vars.afterRestart.eventHistory[0].choiceId", "expected": "HELP" },
    { "action": "screenshot", "name": "choice-after-restart", "description": "Capture the restored authoritative story state" }
  ]
}
