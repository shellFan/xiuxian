{
  "id": "fate-secret-trial",
  "title": "Fund and resolve the hidden coffee branch, then verify secret trial defeat through the real V3 battle",
  "setup": "new-player",
  "setupFailureClass": "SETUP_BLOCKED",
  "steps": [
    {
      "action": "setViewport",
      "width": 1280,
      "height": 720
    },
    {
      "action": "call",
      "method": "queryHomeSnapshot",
      "as": "beforeTask",
      "asType": "object",
      "description": "Read the existing salary wallet before completing the first assigned task"
    },
    {
      "action": "assertClickable",
      "selector": ".ux59f-onboarding [data-action=assignedDone]",
      "description": "Verify the real onboarding-task control is visible and unobstructed"
    },
    {
      "action": "click",
      "selector": ".ux59f-onboarding [data-action=assignedDone]",
      "description": "Complete the first assigned task through its visible UI and canonical task service"
    },
    {
      "action": "call",
      "method": "queryHomeSnapshot",
      "as": "afterTask",
      "asType": "object"
    },
    {
      "action": "assert",
      "check": "gte",
      "path": "@vars.afterTask.work.salaryBalance",
      "expected": 18,
      "description": "The real task reward funds coffee without injecting wallet state"
    },
    {
      "action": "click",
      "selector": "#ArenaAttack",
      "description": "Enter the first regular card battle from the normal home combat entry"
    },
    {
      "action": "waitFor",
      "selector": ".ux-cardbattle[data-card-phase=\"PLAYER_ACTION\"]",
      "timeoutMs": 5000
    },
    {
      "action": "clickIfPresent",
      "selector": ".ux-weekly-popup .ux-week-close",
      "timeoutMs": 3000
    },
    {
      "action": "clickIfPresent",
      "selector": ".ux-modal-layer .ux-event-option[data-vevent-choice='NOT_HOME'], .ux-modal-layer .ux-event-option[data-weekend='SECLUDED_CULTIVATE'], .ux-modal-layer #V2EventOk",
      "timeoutMs": 3000
    },
    {
      "action": "cardBattleAdvance",
      "popupChoiceSelector": ".ux-modal-layer .ux-event-option, .ux-modal-layer #V2EventOk, .ux-weekly-popup .ux-week-close, .ux-modal-layer [data-vevent-choice=\"__auto\"], .ux-modal-layer .ux-reply-option",
      "timeoutMs": 5000,
      "description": "Play a visible attack or other playable card; if the hand has no playable card, end the turn through the real control",
      "routeRecoverySelector": ".ux-screen:has(.ux-messenger) .ux-header [data-action=\"back\"]",
      "routeRecoveryTargetSelector": ".ux-cardbattle",
      "routeRecoveryResumeSelector": "#ArenaAttack",
      "routeRecoveryTimeoutMs": 3000
