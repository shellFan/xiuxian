      "action": "assert",
      "check": "equals",
      "path": "@vars.battleAfterAdvance.phase",
      "expected": "VICTORY",
      "description": "The normal battle must be won through actual visible card play"
    },
    {
      "action": "waitFor",
      "selector": ".ux-cardbattle[data-card-phase=\"VICTORY\"]",
      "timeoutMs": 5000,
      "popupChoiceSelector": ".ux-modal-layer .ux-event-option, .ux-modal-layer [data-vevent-choice=\"__auto\"]"
    },
    {
      "action": "screenshot",
      "name": "normal-battle-1-victory",
      "description": "Capture the visible card-battle victory after shuffled-hand progression"
    },
    {
      "action": "clickUntilState",
      "selector": "[data-action=\"cardReward\"]",
      "method": "queryCardBattle",
      "popupChoiceSelector": ".ux-modal-layer .ux-event-option, .ux-modal-layer #V2EventOk, .ux-weekly-popup .ux-week-close, .ux-modal-layer [data-vevent-choice=\"__auto\"]",
      "path": "rewards[0].chosen",
      "from": false,
      "expected": true,
      "maxAttempts": 3,
      "timeoutMs": 1000,
      "description": "Choose the first card reward through its visible option"
    },
    {
      "action": "clickUntilState",
      "selector": "[data-action=\"cardClaim\"]",
      "method": "queryCardBattle",
      "popupChoiceSelector": ".ux-modal-layer .ux-event-option, .ux-modal-layer #V2EventOk, .ux-weekly-popup .ux-week-close, .ux-modal-layer [data-vevent-choice=\"__auto\"]",
      "path": "settlement.claimed",
      "from": false,
      "expected": true,
      "maxAttempts": 3,
      "timeoutMs": 1000,
      "description": "Claim the first battle reward through its visible settlement control"
    },
    {
      "action": "click",
      "selector": "[data-action=\"cardClear\"]",
      "popupChoiceSelector": ".ux-modal-layer .ux-event-option, .ux-modal-layer #V2EventOk, .ux-weekly-popup .ux-week-close, .ux-modal-layer [data-vevent-choice=\"__auto\"]",
      "description": "Dismiss the claimed battle result through the visible Return to Project Entry control"
    },
    {
      "action": "call",
      "method": "queryCardBattle",
      "as": "afterFirstClear",
      "asType": "null",
      "description": "Verify the finished battle was cleared before leaving its settlement panel"
    },
    {
      "action": "assert",
      "check": "equals",
      "path": "@vars.afterFirstClear",
      "expected": null,
      "description": "No finished card battle remains after visible result dismissal"
    },
    {
      "action": "call",
      "method": "queryFateRun",
      "as": "afterFirstWin",
      "asType": "object"
    },
    {
      "action": "assert",
      "check": "equals",
      "path": "@vars.afterFirstWin.eventQueue[0]",
      "expected": "intern_s1"
    },
    {
      "action": "click",
      "selector": "[data-nav=\"HOME\"]",
      "description": "Return home to resolve the first card-battle story milestone"
    },
    {
      "action": "waitFor",
      "selector": "#FateEventCard[data-event-id=intern_s1]:not([hidden])",
      "timeoutMs": 5000,
      "popupChoiceSelector": ".ux-modal-layer .ux-event-option, .ux-modal-layer [data-vevent-choice=\"__auto\"]"
    },
    {
      "action": "clickUntilState",
      "selector": "#FateEventChoices [data-fate-choice=HELP]",
      "popupChoiceSelector": ".ux-modal-layer .ux-event-option, .ux-modal-layer [data-vevent-choice=\"__auto\"]",
      "method": "queryFateRun",
      "path": "eventQueue[0]",
      "from": "intern_s1",
      "expected": "intern_s2",
      "maxAttempts": 3,
      "timeoutMs": 1000
    },
    {
      "action": "waitFor",
