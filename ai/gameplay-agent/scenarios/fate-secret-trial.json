{
  "id": "fate-secret-trial",
  "title": "Fund and resolve the hidden coffee branch, then verify secret trial defeat through the real V3 battle",
  "setup": "new-player",
  "setupFailureClass": "SETUP_BLOCKED",
  "steps": [
    {
      "action": "setViewport",
      "width": 1280,
      "height": 720
    },
    {
      "action": "call",
      "method": "queryHomeSnapshot",
      "as": "beforeTask",
      "asType": "object",
      "description": "Read the existing salary wallet before completing the first assigned task"
    },
    {
      "action": "assertClickable",
      "selector": ".ux59f-onboarding [data-action=assignedDone]",
      "description": "Verify the real onboarding-task control is visible and unobstructed"
    },
    {
      "action": "click",
      "selector": ".ux59f-onboarding [data-action=assignedDone]",
      "description": "Complete the first assigned task through its visible UI and canonical task service"
    },
    {
      "action": "call",
      "method": "queryHomeSnapshot",
      "as": "afterTask",
      "asType": "object"
    },
    {
      "action": "assert",
      "check": "gte",
      "path": "@vars.afterTask.work.salaryBalance",
      "expected": 18,
      "description": "The real task reward funds coffee without injecting wallet state"
    },
    {
      "action": "clickUntilState",
      "selector": "#ArenaAttack",
      "method": "queryHomeArena",
      "path": "kills",
      "from": 0,
      "expected": 1,
      "maxAttempts": 3,
      "timeoutMs": 1000,
      "description": "Defeat the first enemy with the visible attack control"
    },
    {
      "action": "clickUntilState",
      "selector": "#ArenaAttack",
      "method": "queryHomeArena",
      "path": "kills",
      "from": 1,
      "expected": 2,
      "maxAttempts": 3,
      "timeoutMs": 1000,
      "description": "Reach the first intern event milestone through visible combat"
    },
    {
      "action": "waitFor",
      "selector": "#FateEventCard[data-event-id=intern_s1]:not([hidden])",
      "timeoutMs": 5000
    },
    {
      "action": "click",
      "selector": "#FateEventChoices [data-fate-choice=HELP]",
      "description": "Help the intern through the visible event option"
    },
    {
      "action": "waitFor",
      "selector": "#FateEventCard[data-event-id=intern_s2]:not([hidden])",
      "timeoutMs": 5000
    },
    {
      "action": "click",
      "selector": "#FateEventChoices [data-fate-choice=HELP]",
      "description": "Choose the branch that unlocks the hidden coffee event"
    },
    {
      "action": "waitFor",
      "selector": "#FateEventCard[data-event-id=intern_s3]:not([hidden])",
      "timeoutMs": 5000
    },
    {
      "action": "click",
      "selector": "#FateEventChoices [data-fate-choice=HELP]",
      "description": "Continue the intern chain using its rendered choice"
    },
    {
      "action": "clickUntilState",
      "selector": "#ArenaAttack",
      "method": "queryHomeArena",
      "path": "kills",
      "from": 2,
      "expected": 3,
      "maxAttempts": 3,
      "timeoutMs": 1000,
      "description": "Continue the first stage toward the coffee-event milestone"
    },
    {
      "action": "clickUntilState",
      "selector": "#ArenaAttack",
      "method": "queryHomeArena",
      "path": "kills",
      "from": 3,
      "expected": 4,
      "maxAttempts": 3,
      "timeoutMs": 1000,
      "description": "Continue the first stage toward the coffee-event milestone"
    },
    {
      "action": "clickUntilState",
      "selector": "#ArenaAttack",
      "method": "queryHomeArena",
      "path": "kills",
      "from": 4,
      "expected": 5,
      "maxAttempts": 3,
      "timeoutMs": 1000,
      "description": "Reach the authored arena:1:5 hidden-event trigger"
    },
    {
      "action": "waitFor",
      "selector": "#FateEventCard[data-event-id=coffee_event]:not([hidden])",
      "timeoutMs": 7000,
      "description": "Wait for the hidden event unlocked by the prior visible story choices"
    },
    {
      "action": "screenshot",
      "name": "secret-trial-choice",
      "description": "Capture the hidden event and its real choices before selecting"
    },
    {
      "action": "assertClickable",
      "selector": "#FateEventChoices [data-fate-choice=HELP]"
    },
    {
      "action": "call",
      "method": "queryHomeSnapshot",
      "as": "beforeCoffee",
      "asType": "object"
    },
    {
      "action": "click",
      "selector": "#FateEventChoices [data-fate-choice=HELP]",
      "description": "Buy coffee through its real event choice and debit the existing salary wallet"
    },
    {
      "action": "call",
      "method": "queryHomeSnapshot",
      "as": "afterCoffee",
      "asType": "object"
    },
    {
      "action": "assert",
      "check": "change",
      "path": "@vars.afterCoffee.work.salaryBalance",
      "from": "@vars.beforeCoffee.work.salaryBalance",
      "expected": -18,
      "description": "The hidden event charges the canonical wallet exactly ¥18 before opening the trial"
    },
    {
      "action": "call",
      "method": "queryFateRun",
      "as": "afterUnlock",
      "asType": "object",
      "description": "Read the canonical run after resolving the hidden event"
    },
    {
      "action": "assert",
      "check": "equals",
      "path": "@vars.afterUnlock.activeChallengeId",
      "expected": "secret_trial"
    },
    {
      "action": "assertClickable",
      "selector": "#FateChallengeControls [data-fate-challenge=\"start\"]"
    },
    {
      "action": "click",
      "selector": "#FateChallengeControls [data-fate-challenge=\"start\"]",
      "description": "Start the challenge through its visible control, backed by V3 BattleService"
    },
    {
      "action": "call",
      "method": "queryFateRun",
      "as": "duringChallenge",
      "asType": "object"
    },
    {
      "action": "assert",
      "check": "truthy",
      "path": "@vars.duringChallenge.activeChallengeBattleRunId",
      "description": "The authoritative run must contain the actual V3 battle run ID"
    },
    {
      "action": "click",
      "selector": ".ux-nav-item[data-nav=PROJECT]",
      "description": "Open the existing project battle page from its main navigation control"
    },
    {
      "action": "waitFor",
      "selector": ".ux-battle2",
      "timeoutMs": 5000
    },
    {
      "action": "call",
      "method": "queryBattle",
      "as": "actualBattle",
      "asType": "object",
      "description": "Read the existing authoritative V3 battle run without mutating it"
    },
    {
      "action": "assert",
      "check": "equals",
      "path": "@vars.actualBattle.source",
      "expected": "INCIDENT",
      "description": "The special challenge is backed by the existing incident battle mode"
    },
    {
      "action": "screenshot",
      "name": "secret-trial-battle",
      "description": "Capture the actual challenge boss and V3 battle controls"
    },
    {
      "action": "assertClickable",
      "selector": "[data-action=abandonBattle]"
    },
    {
      "action": "click",
      "selector": "[data-action=abandonBattle]",
      "description": "Use the rendered battle exit control to produce a real failed challenge result"
    },
    {
      "action": "call",
      "method": "queryFinishedBattle",
      "as": "abandonedBattle",
      "asType": "object",
      "description": "Read authoritative battle settlement immediately after using the visible abandon control"
    },
    {
      "action": "assert",
      "check": "equals",
      "path": "@vars.abandonedBattle.status",
      "expected": "DEFEAT",
      "description": "The actual V3 challenge records defeat even when a workplace event appears before its result UI"
    },
    {
      "action": "waitFor",
      "selector": ".ux-modal-layer [data-vevent-choice=\"__auto\"]",
      "timeoutMs": 5000,
      "description": "Wait for the real no-choice workplace event that can interrupt the defeat result presentation"
    },
    {
      "action": "click",
      "selector": ".ux-modal-layer [data-vevent-choice=\"__auto\"]",
      "description": "Resolve the visible workplace event through its actual acknowledgement button"
    },
    {
      "action": "waitFor",
      "selector": ".ux-modal-layer #V2EventOk",
      "timeoutMs": 5000,
      "description": "Wait for the event result acknowledgement after choosing its visible option"
    },
    {
      "action": "click",
      "selector": ".ux-modal-layer #V2EventOk",
      "description": "Close the actual event result popup through its visible continue button"
    },
    {
      "action": "wait",
      "ms": 300,
      "description": "Allow the challenge defeat presentation to resume after the real event popup closes"
    },
    {
      "action": "waitFor",
      "selector": "[data-battle-fallback-exit]",
      "timeoutMs": 5000,
      "description": "Wait for the real battle-abort result dialog and its explicit exit control"
    },
    {
      "action": "assertClickable",
      "selector": "[data-battle-fallback-exit]"
    },
    {
      "action": "click",
      "selector": "[data-battle-fallback-exit]",
      "description": "Acknowledge the visible abort result through its fallback UI control"
    },
    {
      "action": "click",
      "selector": ".ux-nav-item[data-nav=PROJECT]",
      "description": "Return to the existing project battle page after acknowledging the result"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "call",
      "method": "queryFateRun",
      "as": "afterDefeat",
      "asType": "object",
      "description": "Read the authoritative challenge result after normal game-loop settlement"
    },
    {
      "action": "assert",
      "check": "equals",
      "path": "@vars.afterDefeat.flags[\"challenge:secret_trial:DEFEAT\"]",
      "expected": true,
      "description": "Challenge loss is recorded under its namespaced authoritative outcome flag"
    },
    {
      "action": "assert",
      "check": "equals",
      "path": "@vars.afterDefeat.activeChallengeBattleRunId",
      "expected": null,
      "description": "The settled challenge clears its active battle reference"
    },
    {
      "action": "screenshot",
      "name": "secret-trial-defeat",
      "description": "Capture the post-settlement run state for the replay record"
    }
  ]
}
