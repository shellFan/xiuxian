{
  "firstWeekStory": {
    "1": {
      "id": "week1_mon",
      "theme": "初入仙门",
      "steps": [
        { "id": "w1m_intro", "atMinute": 545, "conversation": "conv_boss", "actor": "BOSS", "priority": "NORMAL", "sender": "领导", "text": "今天第一天，先熟悉下环境。中午自我介绍一下。", "replies": [ { "id": "a", "text": "认真准备自我介绍", "effects": { "performance": 1 } }, { "id": "b", "text": "摸过去就行", "effects": { "mind": 1 } } ] },
        { "id": "w1m_first_task", "atMinute": 660, "conversation": "conv_system", "actor": "SYSTEM", "priority": "NORMAL", "sender": "系统", "text": "你接到了第一个正式任务。万事开头难。", "replies": [ { "id": "a", "text": "全力以赴", "effects": { "performance": 1 } } ] },
        { "id": "w1m_first_bug", "atMinute": 930, "conversation": "conv_tester", "actor": "TESTER", "priority": "NORMAL", "sender": "测试仙子", "text": "你的代码有个小Bug，别慌，都这样过来的。", "replies": [ { "id": "a", "text": "马上修复（认真复盘）", "effects": { "performance": 1, "reality": { "text": "为第一天的小Bug复盘了20分钟", "kind": "WORK" } } }, { "id": "b", "text": "「不可能，我本地是好的」", "effects": { "mind": -1, "performance": -1 } } ] },
        { "id": "w1m_offwork", "atMinute": 1075, "conversation": "conv_veteran", "actor": "VETERAN", "priority": "NORMAL", "sender": "老油条", "text": "第一天居然准时下班了？要么你是神仙，要么……明天再说。", "replies": [ { "id": "a", "text": "「明天见！」", "effects": { "mind": 2 } } ] }
      ]
    },
    "2": {
      "id": "week1_tue",
      "theme": "这个顺手帮一下",
      "steps": [
        { "id": "w1t_favor", "atMinute": 610, "conversation": "conv_veteran", "actor": "VETERAN", "priority": "NORMAL", "sender": "老油条", "text": "兄弟，帮我看一下这个问题，就五分钟。", "replies": [ { "id": "a", "text": "帮忙（实际40分钟）", "effects": { "npc": [["VETERAN", 3]], "mind": -1, "reality": { "text": "帮老油条看了『五分钟』问题（40分钟）", "kind": "FAVOR" } } }, { "id": "b", "text": "「我手头有活」", "effects": { "npc": [["VETERAN", -2]], "mind": 1 } } ] },
        { "id": "w1t_favor2", "atMinute": 960, "conversation": "conv_junior", "actor": "JUNIOR", "priority": "NORMAL", "sender": "新人", "text": "前辈，这个工具怎么配啊？文档我看不懂。", "replies": [ { "id": "a", "text": "耐心教他", "effects": { "npc": [["JUNIOR", 2]], "performance": 1, "reality": { "text": "教新人配工具（20分钟）", "kind": "FAVOR" } } }, { "id": "b", "text": "「看文档」", "effects": { "npc": [["JUNIOR", -1]] } } ] }
      ]
    },
    "3": {
      "id": "week1_wed",
      "theme": "需求真的没变",
      "steps": [
        { "id": "w1w_req", "atMinute": 640, "conversation": "conv_product", "actor": "PRODUCT", "priority": "HIGH", "sender": "产品真君", "text": "需求没变，只是实现方式调整了一下。你之前做的那版……推倒吧。", "replies": [ { "id": "a", "text": "要求更新需求文档", "tag": "PROFESSIONAL", "effects": { "evidence": [["REQUIREMENT", "周三需求变更记录"]], "reality": { "text": "要求产品补需求变更文档（15分钟）", "kind": "CHANGE" } } }, { "id": "b", "text": "口头答应", "effects": { "mind": -2, "reality": { "text": "默默接受了推倒重来（45分钟）", "kind": "CHANGE" } } }, { "id": "c", "text": "找领导确认优先级", "effects": { "npc": [["BOSS", -1]], "evidence": [["REQUIREMENT", "领导优先级确认记录"]] } } ] },
        { "id": "w1w_evidence", "atMinute": 990, "conversation": "conv_system", "actor": "SYSTEM", "priority": "NORMAL", "sender": "系统", "text": "你保存的需求文档已经攒了三版。证据，是牛马唯一的护身符。", "replies": [ { "id": "a", "text": "（默默整理证据链）", "effects": { "evidence": [["REQUIREMENT", "需求文档三版存档"]] } } ] }
      ]
    },
    "4": {
      "id": "week1_thu",
      "theme": "线上事故",
      "steps": [
        { "id": "w1th_alarm", "atMinute": 650, "conversation": "conv_incident", "actor": "OPS", "priority": "CRITICAL", "sender": "运维老哥", "text": "线上事故！核心接口500，拉应急群！", "replies": [ { "id": "a", "text": "立即响应", "effects": { "performance": 2, "reality": { "text": "参与线上事故应急（40分钟）", "kind": "INCIDENT" } } }, { "id": "b", "text": "等定位结果", "effects": { "performance": -1 } } ] },
        { "id": "w1th_postmortem", "atMinute": 1020, "conversation": "conv_boss", "actor": "BOSS", "priority": "HIGH", "sender": "领导", "text": "复盘开始。我们不追责——那么，这段代码是谁写的？", "replies": [ { "id": "a", "text": "主动认领并给改进方案", "effects": { "performance": 2, "mind": -1 } }, { "id": "b", "text": "拿出时间线证据自证", "effects": { "performance": 1 } }, { "id": "c", "text": "沉默", "effects": { "performance": -2, "mind": -2 } } ] }
      ]
    },
    "5": {
      "id": "week1_fri",
      "theme": "17:55",
      "steps": [
        { "id": "w1f_typing", "atMinute": 1071, "conversation": "conv_boss", "actor": "BOSS", "priority": "HIGH", "sender": "领导", "text": "（老板正在输入……）", "replies": [ { "id": "a", "text": "（屏住呼吸）", "effects": {} } ] }
      ]
    },
    "6": {
      "id": "week1_sat",
      "theme": "周末（有概率被召回）",
      "steps": [
        { "id": "w1sa_call", "atMinute": 720, "conversation": "conv_boss", "actor": "BOSS", "priority": "NORMAL", "sender": "领导", "text": "（周六下午，手机震动）「在吗？」", "replies": [ { "id": "a", "text": "回消息：马上上线", "effects": { "mind": -3, "overtime": { "source": "BOSS", "free": true, "seconds": 7200 } } }, { "id": "b", "text": "关静音，继续睡", "effects": { "npc": [["BOSS", -1]], "mind": 3 } } ] }
      ]
    },
    "7": {
      "id": "week1_sun",
      "theme": "周结算",
      "steps": [
        { "id": "w1su_settle", "atMinute": 600, "conversation": "conv_system", "actor": "SYSTEM", "priority": "NORMAL", "sender": "系统", "text": "第一周结束了。本周牛马周报已生成。", "replies": [ { "id": "a", "text": "查看周报", "effects": {} } ] }
      ]
    }
  },
  "weeklyHooks": [
    "支付系统将在下周一上线。",
    "老板似乎准备找你聊晋升的事。",
    "测试仙子最近对你的态度有所改变。",
    "祖传后台系统的监控曲线最近有点不对劲。",
    "产品真君又攒了一份『小』需求。",
    "你的职业经验距离升级只差一步了。"
  ],
