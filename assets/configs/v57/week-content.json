    { "id": "sit_meeting_hell", "name": "会议地狱", "desc": "今天3~4场会，你的工位空了大半。", "weight": 8, "interruptBudget": [6, 10], "effects": { "meetingMinutes": 120 } },
    { "id": "sit_incident_day", "name": "事故之日", "desc": "监控曲线一早就开始跳舞。", "weight": 6, "interruptBudget": [6, 10], "effects": { "incidentChanceMul": 1.8 } },
    { "id": "sit_deadline_day", "name": "DeadLine日", "desc": "今天不交付，明天就得走人（不是辞职那种）。", "weight": 8, "interruptBudget": [4, 7], "effects": { "taskEfficiency": 0.1, "fatigueGainMul": 1.2 } },
