    { "id": "sit_client_visit", "name": "客户来访", "desc": "客户来公司参观，全员进入表演模式。", "weight": 5, "interruptBudget": [4, 7], "effects": { "performanceMul": 1.05 } },
    { "id": "sit_release_day", "name": "发布日", "desc": "今天上线。技术债越高，今天越刺激。", "weight": 8, "interruptBudget": [6, 10], "effects": { "incidentChanceMul": 1.5 } },
    { "id": "sit_payday", "name": "发薪日", "desc": "工资到账，苦难有了回报（的一部分）。", "weight": 6, "interruptBudget": [3, 6], "effects": { "mindRecoveryMul": 1.2 } },
    { "id": "sit_friday", "name": "星期五", "desc": "熬过今天就是周末。", "weight": 6, "interruptBudget": [3, 6], "effects": { "mindRecoveryMul": 1.1 } },
    { "id": "sit_monday", "name": "星期一", "desc": "周一的精神状态堪比渡劫失败。", "weight": 6, "interruptBudget": [3, 6], "effects": { "fatigueGainMul": 1.15 } },
    { "id": "sit_team_building", "name": "团建日", "desc": "占用周末的『福利』，名为团建，实为加班。", "weight": 4, "interruptBudget": [2, 4], "effects": { "mindChange": -2 } }
