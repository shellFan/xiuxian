    { "id": "sec_drink_buddy", "name": "老油条的酒局", "condition": { "type": "HELP_NPC", "npcId": "VETERAN", "count": 3 }, "text": "老油条难得请客：『走，楼下撸串，我请。今天不聊工作。』", "reward": { "mind": 15, "npc": [["VETERAN", 5]] } },
    { "id": "sec_evidence_master", "name": "证据链大师", "condition": { "type": "EVIDENCE_TOTAL", "count": 15 }, "text": "你的需求文档柜比产品经理的还厚。没人敢随便甩锅给你了。", "reward": { "professionExp": 80 } },
    { "id": "sec_legacy_awakens", "name": "祖传代码老祖苏醒", "condition": { "type": "TECH_DEBT", "value": 100 }, "text": "技术债突破100。祖传后台深夜发出低语：『该……还债了。』", "reward": { "professionExp": 60, "incidentRisk": 10 } },
