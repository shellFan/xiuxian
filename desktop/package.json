{
  "name": "xiuxian-desktop",
  "version": "1.0.0",
  "description": "牛马修仙传 - PC Desktop Edition",
  "main": "main.cjs",
  "scripts": {
    "dev": "node ../scripts/check-web-v1-build.cjs && electron . --dev",
    "start": "electron .",
    "pack": "electron-packager . 牛马修仙传 --platform=win32 --arch=x64 --overwrite --out=../dist --icon=assets/icon.ico --asar",
    "pack:portable": "electron-packager . 牛马修仙传 --platform=win32 --arch=x64 --overwrite --out=../dist --icon=assets/icon.ico --asar --portable",
    "build:copy": "node ../scripts/copy-web-build.cjs",
    "prepack": "npm run build:copy"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-packager": "^17.1.2"
  }
}
