{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xiuxian.local/schema/phase4/daily-tasks.schema.json",
  "title": "Phase 4 daily task candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "runtimeEnabled", "selection", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "PHASE4_CANDIDATE" },
    "runtimeEnabled": { "const": false },
    "selection": { "$ref": "#/$defs/selection" },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "nonBlank": { "type": "string", "pattern": "\\S" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "rewardAmount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "salary": { "$ref": "#/$defs/rewardAmount" },
        "performance": { "$ref": "#/$defs/rewardAmount" },
        "cultivation": { "$ref": "#/$defs/rewardAmount" },
        "mind": { "$ref": "#/$defs/rewardAmount" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "perDay", "policy"],
      "properties": {
        "status": { "const": "NEEDS_SERVICE_CAPABILITY" },
        "perDay": { "enum": [5, 6] },
        "policy": { "$ref": "#/$defs/nonBlank", "maxLength": 200 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "description", "target", "reward"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlank", "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "sourceId": { "$ref": "#/$defs/nonBlank", "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "type": { "enum": ["MERGE_5", "WORK_10_MIN", "FISH_3_MIN", "EVENT_3", "KPI_COMPLETE", "PROMOTION_1"] },
        "name": { "$ref": "#/$defs/nonBlank", "maxLength": 18 },
        "description": { "$ref": "#/$defs/nonBlank", "maxLength": 100 },
        "target": { "$ref": "#/$defs/positiveInteger" },
        "reward": { "$ref": "#/$defs/reward" }
      }
    }
  }
}
