    "content:check": "node scripts/check-v2-content.cjs",
    "content:fate:check": "node scripts/check-fate-content.cjs",
    "gameplay-v2:check": "npm run build:game && node scripts/check-v2-content.cjs && node scripts/check-legacy-merge.cjs",
    "pc:dev": "cd desktop && npm run dev",
    "pc:start": "cd desktop && npm start",
    "pc:build": "node scripts/build-web.cjs",
    "pc:check": "node scripts/check-web-v1-build.cjs",
    "pc:copy": "cd desktop && npm run build:copy",
    "pc:pack": "cd desktop && npm run pack",
    "pc:pack:portable": "cd desktop && npm run pack:portable",
    "pc:serve": "node scripts/serve-web-desktop.cjs",
